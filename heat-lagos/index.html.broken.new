            "@type": "PostalAddress",
            "streetAddress": "Edificio da Fabrica da Ribeira, Av. dos Descobrimentos, Loja G",
            "addressLocality": "Lagos",
            "addressRegion": "Algarve",
            "addressCountry": "PT",
            "postalCode": "8600-854"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": "37.1028",
            "longitude": "-8.6730"
        },
        "priceRange": "€€",
        "openingHours": ["Mo-Fr 07:00-21:00", "Sa-Su 08:00-18:00"],
        "paymentAccepted": "Cash, Credit Card, PayPal",
        "currenciesAccepted": "EUR",
        "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Class Packages",
            "itemListElement": [
                {
                    "@type": "Offer",
                    "itemOffered": {"@type": "Service", "name": "Drop-In Class"},
                    "price": "22",
                    "priceCurrency": "EUR"
                },
                {
                    "@type": "Offer",
                    "itemOffered": {"@type": "Service", "name": "Vacation Week Unlimited"},
                    "price": "59",
                    "priceCurrency": "EUR"
                },
                {
                    "@type": "Offer",
                    "itemOffered": {"@type": "Service", "name": "14-Day Intro Unlimited"},
                    "price": "79",
                    "priceCurrency": "EUR"
                }
            ]
        },
        "sameAs": ["https://www.instagram.com/heatlagos"]
    }
    </script>
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0a0a; color: #fff; line-height: 1.6; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        
        nav { padding: 20px 0; position: sticky; top: 0; background: rgba(10,10,10,0.95); backdrop-filter: blur(10px); z-index: 100; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .nav-inner { display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 24px; font-weight: 700; color: #ff6b35; text-decoration: none; }
        .logo span { color: #fff; font-weight: 300; }
        .nav-links a { color: #aaa; text-decoration: none; margin-left: 30px; transition: color 0.3s; font-size: 14px; }
        .nav-links a:hover { color: #ff6b35; }
        .nav-cta { background: #ff6b35; color: #fff; padding: 8px 20px; border-radius: 20px; font-weight: 700; text-decoration: none; font-size: 14px; }
        
        .hero { padding: 100px 0 60px; text-align: center; }
        .hero h1 { font-size: 48px; margin-bottom: 20px; line-height: 1.2; }
        .hero h1 .highlight { color: #ff6b35; }
        .hero-subtitle { font-size: 20px; color: #aaa; margin-bottom: 40px; max-width: 700px; margin-left: auto; margin-right: auto; }
        .badge { display: inline-block; background: rgba(255,107,53,0.2); color: #ff6b35; padding: 8px 16px; border-radius: 20px; font-size: 14px; margin-bottom: 30px; }
        .cta-group { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }
        .btn-primary { background: #ff6b35; color: #fff; padding: 15px 40px; border: none; border-radius: 30px; font-size: 16px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; }
        .btn-secondary { background: transparent; color: #ff6b35; padding: 15px 40px; border: 2px solid #ff6b35; border-radius: 30px; font-size: 16px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; }
        
        .trust-bar { background: rgba(255,255,255,0.03); padding: 30px 0; border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05); }
        .trust-items { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; }
        .trust-item { display: flex; align-items: center; gap: 10px; color: #888; font-size: 14px; }
        .trust-item .icon { color: #ff6b35; font-size: 18px; }
        
        .features { padding: 80px 0; }
        .features h2 { text-align: center; font-size: 36px; margin-bottom: 60px; }
        .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; }
        .feature-card { padding: 40px 30px; background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); }
        .feature-card h3 { font-size: 24px; margin-bottom: 15px; color: #ff6b35; }
        .feature-card p { color: #aaa; font-size: 15px; margin-bottom: 20px; }
        .feature-card a { color: #ff6b35; text-decoration: none; font-weight: 700; }
        .feature-card a:hover { text-decoration: underline; }
        
        .pricing { padding: 80px 0; background: rgba(255,255,255,0.02); }
        .pricing h2 { text-align: center; font-size: 36px; margin-bottom: 60px; }
        .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .pricing-card { padding: 40px 30px; background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); text-align: center; }
        .pricing-card.featured { border: 2px solid #ff6b35; }
        .pricing-card h3 { font-size: 20px; margin-bottom: 15px; }
        .pricing-card .price { font-size: 48px; font-weight: 700; color: #ff6b35; margin-bottom: 10px; }
        .pricing-card .price span { font-size: 16px; color: #888; font-weight: 400; }
        .pricing-card p { color: #aaa; font-size: 15px; margin-bottom: 20px; }
        .pricing-card .btn { display: inline-block; background: #ff6b35; color: #fff; padding: 12px 30px; border-radius: 25px; text-decoration: none; font-weight: 700; }
        
        .location-section { padding: 80px 0; }
        .location-section h2 { text-align: center; font-size: 36px; margin-bottom: 20px; }
        .location-section .subtitle { text-align: center; color: #aaa; margin-bottom: 60px; }
        .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
        .location-info h3 { font-size: 24px; margin-bottom: 20px; color: #ff6b35; }
        .location-info p { color: #ccc; margin-bottom: 15px; }
        .location-info ul { margin: 20px 0; padding-left: 20px; }
        .location-info ul li { color: #aaa; margin-bottom: 10px; }
        .location-info .address { background: rgba(255,255,255,0.03); padding: 20px; border-radius: 8px; margin-top: 20px; }
        .location-info .address p { margin-bottom: 5px; font-size: 14px; }
        .location-info .address .label { color: #888; font-size: 12px; text-transform: uppercase; }
        
        .science { padding: 80px 0; background: rgba(255,255,255,0.02); }
        .science h2 { text-align: center; font-size: 36px; margin-bottom: 60px; }
        .science-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; }
        .science-item { padding: 30px; background: rgba(255,255,255,0.03); border-radius: 12px; border-left: 3px solid #ff6b35; }
        .science-item h3 { font-size: 20px; margin-bottom: 15px; }
        .science-item p { color: #aaa; font-size: 15px; }
        
        .reviews { padding: 80px 0; }
        .reviews h2 { text-align: center; font-size: 36px; margin-bottom: 60px; }
        .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .review-card { padding: 30px; background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); }
        .review-card .stars { color: #ff6b35; margin-bottom: 15px; font-size: 20px; }
        .review-card .quote { font-style: italic; color: #ccc; margin-bottom: 20px; font-size: 16px; }
        .review-card .author { color: #ff6b35; font-weight: 700; }
        .review-card .detail { color: #888; font-size: 14px; }
        
        .cta-section { padding: 100px 0; text-align: center; }
        .cta-section h2 { font-size: 36px; margin-bottom: 20px; }
        .cta-section p { color: #aaa; font-size: 18px; margin-bottom: 40px; }
        
        footer { padding: 60px 0 30px; border-top: 1px solid rgba(255,255,255,0.05); }
        .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px; margin-bottom: 40px; }
        .footer-section h4 { font-size: 14px; color: #aaa; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px; }
        .footer-section a { display: block; color: #888; text-decoration: none; margin-bottom: 10px; transition: color 0.3s; font-size: 14px; }
        .footer-section a:hover { color: #ff6b35; }
        .footer-section p { color: #888; font-size: 14px; margin-bottom: 10px; }
        .footer-bottom { text-align: center; color: #555; font-size: 14px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.05); }
        .footer-bottom a { color: #888; }
        
        @media (max-width: 768px) {
            .hero h1 { font-size: 32px; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Heat Lagos | Infrared Hot Yoga & Mat Pilates on Praia da Batata</title>
    <meta name="description" content="Luxury infrared hot yoga & mat Pilates studio in Lagos, Portugal. 30-32°C infrared heat on Praia da Batata beach. Drop-in €22. Vacation week €59. English-only classes.">
    <meta name="keywords" content="hot yoga Lagos, infrared yoga Lagos, mat Pilates Lagos, Pilates sculpt Lagos, yoga studio Praia da Batata, Heat Lagos">
    
    <link rel="canonical" href="https://heatlagos.com/">
    
    <meta property="og:title" content="Heat Lagos | Infrared Hot Yoga & Mat Pilates on Praia da Batata">
    <meta property="og:description" content="30-32°C infrared heat studio on Lagos' most popular beach. English-only classes. Drop-in €22.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://heatlagos.com">
    
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Heat Lagos",
        "alternateName": "Heat Lagos Yoga & Pilates",

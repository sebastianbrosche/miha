            },
            {
                "@type": "Question",
                "name": "How much does yoga teacher training in Portugal cost?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Our 200-hour YTT Portugal costs €1,490 early bird (payable in 3 instalments). Total cost including accommodation and meals typically ranges €2,390-3,290 for the 15-day intensive. Compare all Portugal YTT prices in our cost guide."
                }
            },
            {
                "@type": "Question",
                "name": "What yoga experience do I need before applying?",
                "acceptedAnswer": {
